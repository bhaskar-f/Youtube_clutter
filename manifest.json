{
  "manifest_version": 3,
  "name": "EduGuard",
  "version": "1.0.0",
  "description": "Declutter YouTube and transform it into an educational platform with Education mode",
  "permissions": ["storage", "tabs", "contextMenus", "activeTab"],
  "host_permissions": [
    "*://*.youtube.com/*",
    "https://suggestqueries.google.com/*"
  ],

  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; base-uri 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com"
  },

  "background": {
    "service_worker": "background.js"
  },

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "64": "icons/icon64.png",
    "128": "icons/icon128.png"
  },

  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "64": "icons/icon64.png",
      "128": "icons/icon128.png"
    }
  },

  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["youtubeAPIService.js", "eduguardEngine.js", "contentScript.js"],
      "css": ["instantHide.css"],
      "run_at": "document_start"
    }
  ],

  "web_accessible_resources": [
    {
      "resources": ["youtubeAPIService.js", "eduguardEngine.js"],
      "matches": ["*://*.youtube.com/*"]
    }
  ]
}
